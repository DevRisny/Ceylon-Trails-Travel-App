<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Trails" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/teal</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/teal_soft</item>
        <item name="colorOnPrimaryContainer">@color/teal_dark</item>
        <item name="colorSecondary">@color/saffron</item>
        <item name="colorSecondaryContainer">@color/saffron_soft</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/line</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/card</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="materialCardViewStyle">@style/Widget.Trails.Card</item>
        <item name="chipStyle">@style/Widget.Trails.Chip</item>
    </style>

    <!-- Detail screens: teal status bar above the photo header -->
    <style name="Theme.Trails.Detail" parent="Theme.Trails">
        <item name="android:statusBarColor">@color/teal_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Widget.Trails.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/card</item>
    </style>

    <style name="Widget.Trails.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="chipStrokeColor">@color/line</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="Text.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
    <style name="Text.Muted" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/muted</item>
    </style>
</resources>
